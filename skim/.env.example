# --- Anthropic (summaries) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override; defaults to a fast, cheap model for high feed volume.
SKIM_MODEL=claude-haiku-4-5-20251001

# --- Supabase (sources + items store) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Use the SERVICE ROLE key on the server only (ingest + API routes). Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Daily 9am digest email (the "don't miss anything" push; reuses Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM=Skim <onboarding@resend.dev>
DIGEST_TO=danny.eric.goodman@gmail.com
# Used for the "Open Skim" link in the digest email.
APP_URL=https://your-app.vercel.app

# --- Auth ---
# Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET" to /api/ingest.
CRON_SECRET=generate-a-long-random-string
# Shared token gating source add/remove (sent as "x-skim-token"). Single-user MVP auth.
APP_TOKEN=another-long-random-string
NEXT_PUBLIC_APP_TOKEN=another-long-random-string
